[Desktop Entry]
Type=Application
Name={{{name}}}
{{#if comment}}
Comment={{{comment}}}
{{/if}}
# WEBKIT_DISABLE_DMABUF_RENDERER is defaulted in run() (src-tauri/src/lib.rs),
# not here, so a value set in the environment is respected.
Exec={{{exec}}}
Icon={{{icon}}}
Terminal=false
Categories={{{categories}}}
# Matched against the Wayland app_id / X11 class, which Tauri sets from the
# binary name: keep the exec variable here, the name variable does not match.
StartupWMClass={{{exec}}}
